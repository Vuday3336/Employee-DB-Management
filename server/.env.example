# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/empcore

# --- Auth ---
# Generate strong values for production, e.g. openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Client ---
# Comma-separated list is allowed for multiple origins.
# In production set this to your deployed frontend URL, e.g. https://empcore.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Refresh-cookie SameSite policy.
#   none   - client and API on different domains (the usual split deploy). Requires HTTPS.
#   lax    - both served from one domain; keeps CSRF protection.
# Defaults to 'lax' in development and 'none' in production.
# COOKIE_SAMESITE=none

# --- Business rules ---
# Check-ins after this UTC time are recorded as "late"
WORK_DAY_START=09:15

# Set to false to disable the scheduled jobs (auto-absent, accrual, reminders)
ENABLE_CRON=true

# error | warn | info | debug
LOG_LEVEL=info
