# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (Supabase Postgres) ---
# Supabase dashboard → Project Settings → Database → Connection string.
# Use the *transaction pooler* (port 6543) for serverless deployments; the direct
# connection (port 5432) is fine for a long-running local process.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Optional: a separate database (or schema) for the test suite. `npm test` skips
# with a clear message when this is unset, rather than touching real data.
# DATABASE_URL_TEST=postgresql://...

# --- Auth ---
# Generate strong values for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Client ---
# Comma-separated list is allowed for multiple origins.
# In production set this to your deployed frontend URL.
CLIENT_ORIGIN=http://localhost:5173

# Refresh-cookie SameSite policy.
#   none - client and API on different domains (the usual split deploy). Needs HTTPS.
#   lax  - both served from one domain; keeps CSRF protection.
# Defaults to 'lax' in development and 'none' in production.
# COOKIE_SAMESITE=none

# --- Business rules ---
# Check-ins after this UTC time are recorded as "late"
WORK_DAY_START=09:15

# Scheduled jobs. Always off on Vercel, which has no long-running process.
ENABLE_CRON=true

# error | warn | info | debug
LOG_LEVEL=info
